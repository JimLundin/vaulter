{
  // One config for the kernel (src/), the contracts and the extensions. Extensions import the kernel as
  // @pip/kernel and contracts as @contracts/<name>; the loader resolves the same names in the browser.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@pip/kernel": ["./src/kernel/api.ts"],
      "@contracts/*": ["./contracts/*/index.ts", "./contracts/*"]
    }
  },
  "include": ["src", "contracts", "extensions", "vite.config.ts"]
}
