{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "@solidjs/start/env"
    ],
    "paths": {
      "@/*": [
        "../../../app/*"
      ],
      "@prototype/*": [
        "../shared/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
