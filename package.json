{
  "name": "vaulter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/testing/run.ts vitest run",
    "test:fast": "node tools/testing/run.ts vitest run --project=behavior",
    "test:watch": "node tools/testing/run.ts vitest --project=behavior",
    "test:architecture": "node tools/testing/run.ts vitest run --project=architecture",
    "test:all": "node tools/testing/ci-only.ts && npm run lint && npm run typecheck && npm test && npm run test:ui && npm run test:production",
    "typecheck": "tsc",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "kit": "vite app/ui/kit",
    "design": "vite --mode design --open /preview/",
    "design:agent": "vite --mode design --open '/preview/?agent=live'",
    "build:design": "vite build --mode design && node tools/preview/prepare-design.ts && vite build app/ui/kit --outDir ../../../dist-preview/kit --emptyOutDir",
    "test:ui": "node tools/testing/run.ts playwright test",
    "test:ui:matrix": "node tools/testing/run.ts playwright-matrix test",
    "test:production": "node tools/testing/run.ts playwright test --config tools/testing/production.config.ts",
    "test:mutation": "stryker run tools/testing/stryker.config.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "diff": "^9.0.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.51.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
