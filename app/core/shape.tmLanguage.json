{
  "$comment": "Syntax highlighting for Shape (see Shape Core Thesis). Used for ```shape fences; loaded by app/highlight.tsx. Keep it small: it colours what a reader needs to tell apart, not a full parse.",
  "name": "shape",
  "scopeName": "source.shape",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#binding" },
    { "include": "#label" },
    { "include": "#constructor" },
    { "include": "#builtin-type" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.shape",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.shape",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.shape", "match": "\\\\." }]
    },
    "number": {
      "name": "constant.numeric.shape",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    "binding": {
      "$comment": "A top-level name being defined: `name =` or `name : type =` at the start of a line.",
      "match": "^([a-z_][A-Za-z0-9_]*)(?=\\s*(?::[^=]*)?=(?!=))",
      "captures": { "1": { "name": "entity.name.function.shape" } }
    },
    "label": {
      "$comment": "A label literal, `.name`; `..` (rest/spread) is matched as an operator first.",
      "match": "(?<![.\\w])\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "0": { "name": "constant.other.symbol.shape" } }
    },
    "constructor": {
      "name": "entity.name.type.shape",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "builtin-type": {
      "name": "support.type.primitive.shape",
      "match": "\\b(?:int|float|string|bool)\\b"
    },
    "operator": {
      "name": "keyword.operator.shape",
      "match": "->|<-|\\.\\.|:=|=|:|\\||\\+|-|\\*|/"
    },
    "punctuation": {
      "name": "punctuation.separator.shape",
      "match": "[,(){}]"
    }
  }
}
